// A struct whose only member is a slice has no C aggregate layout: a slice is
// two words, but a lone `{ []u8 }` is ambiguous with a plain two-word value and
// the classifier refuses to guess. Pass a pointer, or name the fields.
struct SliceOnly { data: []u8 }
extern fn c_take(value: SliceOnly);
fn main() i32 { return 0; }
