// An exported variadic function is legal now, but its tail can only be read
// with `va_arg()`, and a retrieval requires a context type: guessing one would
// misread a `double` from the same list. A position with no expected type is
// rejected rather than defaulted.
export fn variadic_exported(value: i32, ...) i32 {
    va_arg();
    return value;
}
fn main() i32 {
    return variadic_exported(1);
}
