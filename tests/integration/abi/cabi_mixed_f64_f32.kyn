struct DoubleFloat { ratio: f64, amount: f32 }

extern fn c_transform(value: DoubleFloat) DoubleFloat;
extern fn c_verify_kyn() i32;

export fn kyn_transform(value: DoubleFloat) DoubleFloat {
    return DoubleFloat {
        ratio: value.ratio + 1.0,
        amount: value.amount + 2.0,
    };
}

fn main() i32 {
    let result: DoubleFloat = c_transform(DoubleFloat { ratio: 2.5, amount: 1.5 });
    return (result.ratio as i32) + (result.amount as i32) + c_verify_kyn();
}
