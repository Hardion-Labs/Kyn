struct SmallTag {
    tag: i32,
}

const DEFAULT_TAG: SmallTag = SmallTag { tag: 5 };
const CONST_SEQ: [4]i32 = [2, 4, 6, 8];

extern fn c_sum_slice(xs: []const i32, tag: SmallTag) i32;
extern fn c_scale_and_tail(xs: []i32, factor: i32) []i32;
extern fn c_call_kyn_middle(ptr: *const i32, len: usize) i32;

export fn kyn_middle_slice(xs: []const i32) []const i32 {
    return xs[1..3];
}

fn main() i32 {
    var nums: [4]i32 = [1, 2, 3, 4];
    let tail: []i32 = c_scale_and_tail(nums[..], 3);
    let a: i32 = c_sum_slice(tail, DEFAULT_TAG);
    let view: []const i32 = CONST_SEQ[..];
    let b: i32 = c_call_kyn_middle(view.ptr, view.len);
    return a + b;
}
