struct Inner { count: i32 }
struct Nested { inner: Inner, amount: f64 }
struct DoublePair { x: f64, y: f64 }
struct NestedPair { pair: DoublePair }
struct FloatLeaf { value: f32 }
struct NestedFloat { inner: FloatLeaf, amount: i64 }

extern fn c_take_nested(value: Nested) Nested;
extern fn c_take_nested_pair(value: NestedPair) NestedPair;
extern fn c_take_nested_float(value: NestedFloat) NestedFloat;
extern fn c_check_kyn() i32;

export fn kyn_take_nested(value: Nested) Nested {
    return Nested {
        inner: Inner { count: value.inner.count + 1 },
        amount: value.amount + 2.0,
    };
}

export fn kyn_take_nested_pair(value: NestedPair) NestedPair {
    return NestedPair {
        pair: DoublePair {
            x: value.pair.x + 1.0,
            y: value.pair.y + 2.0,
        },
    };
}

export fn kyn_take_nested_float(value: NestedFloat) NestedFloat {
    return NestedFloat {
        inner: FloatLeaf { value: value.inner.value + 1.0 },
        amount: value.amount + 2,
    };
}

fn main() i32 {
    let nested = c_take_nested(Nested { inner: Inner { count: 3 }, amount: 10.0 });
    let nested_pair = c_take_nested_pair(NestedPair { pair: DoublePair { x: 4.0, y: 5.0 } });
    let nested_float = c_take_nested_float(NestedFloat { inner: FloatLeaf { value: 6.0 }, amount: 20 });
    let total: i32 = (nested.inner.count as i32) + (nested.amount as i32) +
        (nested_pair.pair.x as i32) + (nested_pair.pair.y as i32) +
        (nested_float.inner.value as i32) + (nested_float.amount as i32);
    return total + c_check_kyn();
}
