struct DoubleLong { ratio: f64, count: i64 }

extern fn c_transform(value: DoubleLong) DoubleLong;
extern fn c_verify_kyn() i32;

export fn kyn_transform(value: DoubleLong) DoubleLong {
    return DoubleLong {
        ratio: value.ratio + 2.0,
        count: value.count + 3,
    };
}

fn main() i32 {
    let result: DoubleLong = c_transform(DoubleLong { ratio: 1.5, count: 4 });
    return (result.ratio as i32) + (result.count as i32) + c_verify_kyn();
}
