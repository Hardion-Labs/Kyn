struct IntFloatPair { a: i32, b: f32, c: f32 }

extern fn c_transform(value: IntFloatPair) IntFloatPair;
extern fn c_verify_kyn() i32;

export fn kyn_transform(value: IntFloatPair) IntFloatPair {
    return IntFloatPair {
        a: value.a + 3,
        b: value.b + 2.0,
        c: value.c + 4.0,
    };
}

fn main() i32 {
    let result: IntFloatPair = c_transform(IntFloatPair { a: 10, b: 1.5, c: 2.5 });
    return result.a + (result.b as i32) + (result.c as i32) + c_verify_kyn();
}
