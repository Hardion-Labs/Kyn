// `bool` is one bit and a float is an IEEE value, so neither direction is a
// single conversion instruction. A bool widens to `i32` and converts unsigned;
// a float compares against zero, unordered-or-not-equal, so a NaN is true as in
// C. Every value below crosses the C boundary.
extern fn c_nan() f64;
extern fn c_inf() f64;
extern fn c_zero() f64;
extern fn c_neg_zero() f64;
extern fn c_half() f64;
extern fn c_narrow_half() f32;
extern fn c_from_flag(flag: i8) f64;

fn main() i32 {
    // Narrowing: nonzero is true, and a NaN is nonzero.
    if (!(c_nan() as bool)) { return 1; }
    if (!(c_inf() as bool)) { return 2; }
    if (c_zero() as bool) { return 3; }
    if (c_neg_zero() as bool) { return 4; }
    if (!(c_half() as bool)) { return 5; }
    if (!(c_narrow_half() as bool)) { return 6; }

    // Widening: false is 0.0 and true is 1.0, exactly, in both widths.
    let on: bool = true;
    let off: bool = false;
    let wide: f64 = on as f64;
    let narrow: f32 = on as f32;
    if (wide != 1.0) { return 7; }
    if (narrow != 1.0) { return 8; }
    if (off as f64 != 0.0) { return 9; }
    if (wide as bool != true) { return 10; }
    if ((off as f64) as bool != false) { return 11; }

    // A round trip through C keeps the value.
    if (c_from_flag(on as i8) != 1.0) { return 12; }
    return 42;
}
