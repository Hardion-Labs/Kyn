struct LongFloat { count: i64, amount: f32 }

extern fn c_transform(value: LongFloat) LongFloat;
extern fn c_verify_kyn() i32;

export fn kyn_transform(value: LongFloat) LongFloat {
    return LongFloat {
        count: value.count + 3,
        amount: value.amount + 1.0,
    };
}

fn main() i32 {
    let result: LongFloat = c_transform(LongFloat { count: 4, amount: 1.5 });
    return (result.count as i32) + (result.amount as i32) + c_verify_kyn();
}
