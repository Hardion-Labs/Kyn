fn fill(values: []i32) {
    values[0] = 100;
    values[1] = 200;
}

fn sum(values: []i32) i32 {
    var total: i32 = 0;
    var index: usize = 0;
    while (index < values.len) {
        total += values[index];
        index += 1;
    }
    return total;
}

fn main() i32 {
    var values: [4]i32 = [1, 2, 3, 4];
    let slice: []i32 = &values as []i32;
    fill(slice);

    let alias: []i32 = slice;
    alias[2] = 30;
    return sum(alias);
}
